{
  "grafito": {
    "$description": "Design System Grafito v1.0. Sistema de diseño neutral, sobrio y funcional para la Plataforma de Administración de Inmuebles, Portales y Contabilidad (Panamá). Configuración inicial sin marca corporativa: al recibir logo y colores del cliente, reemplazar SOLO las primitivas brand.* y scaffold.*; los tokens semánticos no cambian.",
    "$extensions": {
      "grafito": {
        "version": "1.0",
        "status": "en-uso",
        "stack": "blazor-mudblazor",
        "branded": false
      }
    },
    "color": {
      "primitive": {
        "neutral": {
          "neutro-0":   { "$type": "color", "$value": "#FFFFFF" },
          "neutro-50":  { "$type": "color", "$value": "#F8F9FB" },
          "neutro-100": { "$type": "color", "$value": "#F1F3F6" },
          "neutro-200": { "$type": "color", "$value": "#E3E6EB" },
          "neutro-300": { "$type": "color", "$value": "#CFD4DC" },
          "neutro-400": { "$type": "color", "$value": "#A6AEBB" },
          "neutro-500": { "$type": "color", "$value": "#7C8694" },
          "neutro-600": { "$type": "color", "$value": "#5B6470" },
          "neutro-700": { "$type": "color", "$value": "#3E4653" },
          "neutro-800": { "$type": "color", "$value": "#2A313D" },
          "neutro-900": { "$type": "color", "$value": "#1B212B" },
          "neutro-950": { "$type": "color", "$value": "#10151D" }
        },
        "brand": {
          "brand-primary":        { "$type": "color", "$value": "#1B212B" },
          "brand-primary-hover":  { "$type": "color", "$value": "#2A313D" },
          "brand-primary-active": { "$type": "color", "$value": "#10151D" },
          "brand-on-primary":     { "$type": "color", "$value": "#FFFFFF" }
        },
        "semantic-primitive": {
          "success-700": { "$type": "color", "$value": "#146C43" },
          "success-100": { "$type": "color", "$value": "#E7F2EC" },
          "success-300": { "$type": "color", "$value": "#9ECFB3" },
          "danger-700":  { "$type": "color", "$value": "#B42318" },
          "danger-100":  { "$type": "color", "$value": "#FCE8E6" },
          "danger-300":  { "$type": "color", "$value": "#F0A8A0" },
          "warning-800": { "$type": "color", "$value": "#7A4F00" },
          "warning-100": { "$type": "color", "$value": "#FCF3D9" },
          "warning-300": { "$type": "color", "$value": "#E3C768" },
          "info-700":    { "$type": "color", "$value": "#1D4ED8" },
          "info-100":    { "$type": "color", "$value": "#E8F0FE" },
          "info-300":    { "$type": "color", "$value": "#A9C8F5" }
        }
      },
      "semantic": {
        "background": {
          "bg-canvas":          { "$type": "color", "$value": "#F6F7F9" },
          "bg-content":         { "$type": "color", "$value": "#FFFFFF" },
          "bg-subtle":          { "$type": "color", "$value": "#F1F3F6" },
          "bg-muted":           { "$type": "color", "$value": "#E9EDF1" },
          "bg-hover":           { "$type": "color", "$value": "#EDF0F4" },
          "bg-disabled":        { "$type": "color", "$value": "#F1F3F6" }
        },
        "text": {
          "text-primary":    { "$type": "color", "$value": "#1B212B" },
          "text-secondary":  { "$type": "color", "$value": "#5B6470" },
          "text-tertiary":   { "$type": "color", "$value": "#697486" },
          "text-disabled":   { "$type": "color", "$value": "#9AA3AD" },
          "text-inverse":    { "$type": "color", "$value": "#FFFFFF" },
          "text-placeholder":{ "$type": "color", "$value": "#697486" },
          "text-link":       { "$type": "color", "$value": "#1D4ED8" }
        },
        "border": {
          "border-subtle":    { "$type": "color", "$value": "#E3E6EB" },
          "border-default":   { "$type": "color", "$value": "#CFD4DC" },
          "border-strong":    { "$type": "color", "$value": "#A6AEBB" },
          "border-focus":     { "$type": "color", "$value": "#1B212B" }
        },
        "scaffold": {
          "scaffold-bg":          { "$type": "color", "$value": "#141A22" },
          "scaffold-bg-hover":    { "$type": "color", "$value": "#1F2733" },
          "scaffold-bg-active":   { "$type": "color", "$value": "#2A3441" },
          "scaffold-border":      { "$type": "color", "$value": "#2B3442" },
          "scaffold-text":        { "$type": "color", "$value": "#E6E9EE" },
          "scaffold-text-muted":  { "$type": "color", "$value": "#9AA3B0" }
        },
        "status": {
          "status-success":     { "$type": "color", "$value": "#146C43" },
          "status-success-bg":  { "$type": "color", "$value": "#E7F2EC" },
          "status-success-border": { "$type": "color", "$value": "#9ECFB3" },
          "status-warning":     { "$type": "color", "$value": "#7A4F00" },
          "status-warning-bg":  { "$type": "color", "$value": "#FCF3D9" },
          "status-warning-border": { "$type": "color", "$value": "#E3C768" },
          "status-danger":      { "$type": "color", "$value": "#B42318" },
          "status-danger-bg":   { "$type": "color", "$value": "#FCE8E6" },
          "status-danger-border": { "$type": "color", "$value": "#F0A8A0" },
          "status-info":        { "$type": "color", "$value": "#1D4ED8" },
          "status-info-bg":     { "$type": "color", "$value": "#E8F0FE" },
          "status-info-border": { "$type": "color", "$value": "#A9C8F5" },
          "status-neutral":     { "$type": "color", "$value": "#5B6470" },
          "status-neutral-bg":  { "$type": "color", "$value": "#F1F3F6" },
          "status-neutral-border": { "$type": "color", "$value": "#CFD4DC" }
        },
        "chart": {
          "chart-ink":       { "$type": "color", "$value": "#1F2A37" },
          "chart-slate-500": { "$type": "color", "$value": "#7C8694" },
          "chart-slate-300": { "$type": "color", "$value": "#C0C7D1" },
          "chart-blue":      { "$type": "color", "$value": "#2456CC" },
          "chart-green":     { "$type": "color", "$value": "#166B48" },
          "chart-amber":     { "$type": "color", "$value": "#9A6B00" },
          "chart-red":       { "$type": "color", "$value": "#B42318" }
        },
        "overlay": {
          "scrim": { "$type": "color", "$value": "#10151D", "$extensions": { "alfa": 0.45 } },
          "focus-ring": { "$type": "color", "$value": "#1B212B", "$extensions": { "alfa": 0.16 } }
        }
      }
    },
    "typography": {
      "fontFamily": {
        "font-family-ui":   { "$type": "fontFamily", "$value": ["Inter", "Segoe UI", "system-ui", "-apple-system", "sans-serif"] },
        "font-family-mono": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "JetBrains Mono", "Consolas", "monospace"] }
      },
      "fontWeight": {
        "font-weight-regular": { "$type": "fontWeight", "$value": 400 },
        "font-weight-medium":  { "$type": "fontWeight", "$value": 500 },
        "font-weight-semibold":{ "$type": "fontWeight", "$value": 600 },
        "font-weight-bold":    { "$type": "fontWeight", "$value": 700 }
      },
      "type": {
        "text-xs":       { "$type": "typography", "$value": { "fontFamily": "{grafito.typography.fontFamily.font-family-ui}", "fontWeight": 400, "fontSize": "12px", "lineHeight": 1.5, "letterSpacing": "0px" } },
        "text-xs-medium":{ "$type": "typography", "$value": { "fontFamily": "{grafito.typography.fontFamily.font-family-ui}", "fontWeight": 500, "fontSize": "12px", "lineHeight": 1.5, "letterSpacing": "0px" } },
        "text-sm":       { "$type": "typography", "$value": { "fontFamily": "{grafito.typography.fontFamily.font-family-ui}", "fontWeight": 400, "fontSize": "13px", "lineHeight": 1.5, "letterSpacing": "0px" } },
        "text-sm-medium":{ "$type": "typography", "$value": { "fontFamily": "{grafito.typography.fontFamily.font-family-ui}", "fontWeight": 500, "fontSize": "13px", "lineHeight": 1.5, "letterSpacing": "0px" } },
        "text-base":     { "$type": "typography", "$value": { "fontFamily": "{grafito.typography.fontFamily.font-family-ui}", "fontWeight": 400, "fontSize": "14px", "lineHeight": 1.5, "letterSpacing": "0px" } },
        "text-base-medium": { "$type": "typography", "$value": { "fontFamily": "{grafito.typography.fontFamily.font-family-ui}", "fontWeight": 500, "fontSize": "14px", "lineHeight": 1.5, "letterSpacing": "0px" } },
        "text-md":       { "$type": "typography", "$value": { "fontFamily": "{grafito.typography.fontFamily.font-family-ui}", "fontWeight": 400, "fontSize": "16px", "lineHeight": 1.5, "letterSpacing": "0px" } },
        "title-sm":      { "$type": "typography", "$value": { "fontFamily": "{grafito.typography.fontFamily.font-family-ui}", "fontWeight": 600, "fontSize": "20px", "lineHeight": 1.35, "letterSpacing": "-0.01em" } },
        "title-md":      { "$type": "typography", "$value": { "fontFamily": "{grafito.typography.fontFamily.font-family-ui}", "fontWeight": 600, "fontSize": "24px", "lineHeight": 1.3, "letterSpacing": "-0.01em" } },
        "title-lg":      { "$type": "typography", "$value": { "fontFamily": "{grafito.typography.fontFamily.font-family-ui}", "fontWeight": 600, "fontSize": "30px", "lineHeight": 1.25, "letterSpacing": "-0.015em" } },
        "label-caps":    { "$type": "typography", "$value": { "fontFamily": "{grafito.typography.fontFamily.font-family-ui}", "fontWeight": 600, "fontSize": "12px", "lineHeight": 1.4, "letterSpacing": "0.06em", "textTransform": "uppercase" } },
        "mono-sm":       { "$type": "typography", "$value": { "fontFamily": "{grafito.typography.fontFamily.font-family-mono}", "fontWeight": 400, "fontSize": "13px", "lineHeight": 1.5, "letterSpacing": "0px" } },
        "mono-xs":       { "$type": "typography", "$value": { "fontFamily": "{grafito.typography.fontFamily.font-family-mono}", "fontWeight": 400, "fontSize": "12px", "lineHeight": 1.5, "letterSpacing": "0px" } }
      }
    },
    "spacing": {
      "space-0":   { "$type": "dimension", "$value": "0px" },
      "space-1":   { "$type": "dimension", "$value": "2px" },
      "space-2":   { "$type": "dimension", "$value": "4px" },
      "space-3":   { "$type": "dimension", "$value": "8px" },
      "space-4":   { "$type": "dimension", "$value": "12px" },
      "space-5":   { "$type": "dimension", "$value": "16px" },
      "space-6":   { "$type": "dimension", "$value": "20px" },
      "space-7":   { "$type": "dimension", "$value": "24px" },
      "space-8":   { "$type": "dimension", "$value": "32px" },
      "space-9":   { "$type": "dimension", "$value": "40px" },
      "space-10":  { "$type": "dimension", "$value": "48px" },
      "space-11":  { "$type": "dimension", "$value": "64px" },
      "space-12":  { "$type": "dimension", "$value": "80px" },
      "space-page":   { "$type": "dimension", "$value": "24px" },
      "space-page-lg":{ "$type": "dimension", "$value": "32px" },
      "space-section":{ "$type": "dimension", "$value": "24px" },
      "space-stack":  { "$type": "dimension", "$value": "16px" }
    },
    "size": {
      "control-height-sm": { "$type": "dimension", "$value": "28px" },
      "control-height-md": { "$type": "dimension", "$value": "36px" },
      "control-height-lg": { "$type": "dimension", "$value": "44px" },
      "icon-size-sm":      { "$type": "dimension", "$value": "16px" },
      "icon-size-md":      { "$type": "dimension", "$value": "20px" },
      "icon-size-lg":      { "$type": "dimension", "$value": "24px" },
      "sidebar-width":     { "$type": "dimension", "$value": "256px" },
      "sidebar-width-collapsed": { "$type": "dimension", "$value": "72px" },
      "topbar-height":     { "$type": "dimension", "$value": "56px" },
      "table-row-height":  { "$type": "dimension", "$value": "44px" },
      "table-row-height-dense": { "$type": "dimension", "$value": "36px" },
      "focus-ring-width":  { "$type": "dimension", "$value": "2px" },
      "focus-ring-offset": { "$type": "dimension", "$value": "2px" },
      "input-min-target":  { "$type": "dimension", "$value": "44px" }
    },
    "radius": {
      "radius-sm":     { "$type": "dimension", "$value": "4px" },
      "radius-md":     { "$type": "dimension", "$value": "6px" },
      "radius-lg":     { "$type": "dimension", "$value": "8px" },
      "radius-xl":     { "$type": "dimension", "$value": "12px" },
      "radius-pill":   { "$type": "dimension", "$value": "999px" }
    },
    "shadow": {
      "shadow-sm": { "$type": "shadow", "$value": { "color": "#10151D1F", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" } },
      "shadow-md": { "$type": "shadow", "$value": [ { "color": "#10151D1F", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "0px" }, { "color": "#10151D0F", "offsetX": "0px", "offsetY": "1px", "blur": "0px", "spread": "0px" } ] },
      "shadow-lg": { "$type": "shadow", "$value": [ { "color": "#10151D26", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" }, { "color": "#10151D14", "offsetX": "0px", "offsetY": "2px", "blur": "8px", "spread": "0px" } ] },
      "shadow-xl": { "$type": "shadow", "$value": [ { "color": "#10151D3D", "offsetX": "0px", "offsetY": "16px", "blur": "48px", "spread": "0px" }, { "color": "#10151D14", "offsetX": "0px", "offsetY": "4px", "blur": "16px", "spread": "0px" } ] }
    },
    "border": {
      "border-width-hairline": { "$type": "dimension", "$value": "1px" },
      "border-width-focus":    { "$type": "dimension", "$value": "2px" }
    },
    "motion": {
      "duration": {
        "duration-instant": { "$type": "duration", "$value": "0ms" },
        "duration-hover":   { "$type": "duration", "$value": "100ms" },
        "duration-state":   { "$type": "duration", "$value": "150ms" },
        "duration-reveal":  { "$type": "duration", "$value": "200ms" }
      },
      "easing": {
        "ease-standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
        "ease-decelerate": { "$type": "cubicBezier", "$value": [0, 0, 0, 1] }
      }
    },
    "breakpoint": {
      "breakpoint-xs": { "$type": "dimension", "$value": "0px" },
      "breakpoint-sm": { "$type": "dimension", "$value": "600px" },
      "breakpoint-md": { "$type": "dimension", "$value": "960px" },
      "breakpoint-lg": { "$type": "dimension", "$value": "1280px" },
      "breakpoint-xl": { "$type": "dimension", "$value": "1920px" }
    },
    "zIndex": {
      "z-index-sticky":  { "$type": "number", "$value": 100 },
      "z-index-header":  { "$type": "number", "$value": 200 },
      "z-index-drawer":  { "$type": "number", "$value": 300 },
      "z-index-modal":   { "$type": "number", "$value": 400 },
      "z-index-toast":   { "$type": "number", "$value": 500 },
      "z-index-tooltip": { "$type": "number", "$value": 600 }
    }
  }
}